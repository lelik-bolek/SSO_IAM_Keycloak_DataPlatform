# Автоматическая нормализация всех текстовых файлов к LF при коммите
* text=auto eol=lf

# Явная фиксация LF для исполняемых скриптов и конфигураций
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.tsx text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.env text eol=lf

# Изображения и бинарные файлы оставляем без изменений
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.drawio binary